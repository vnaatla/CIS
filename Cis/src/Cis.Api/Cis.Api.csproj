<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- HTTP host and composition root: controllers, JWT, access filter, exception handling, Swagger. Controllers use Cis.Application only;
       Cis.Infrastructure is referenced so Program.cs can register the adapters. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Cis.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cis.Application\Cis.Application.csproj" />
    <ProjectReference Include="..\Cis.Infrastructure\Cis.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cis.Api.Tests" />
  </ItemGroup>

</Project>
