{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cis-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CisDb": "Server=(local);Database=CISDB;Integrated Security=true;Encrypt=false;TrustServerCertificate=true",
    "Reporting": "",
    "SunSystems": ""
  },
  "Auth": {
    "JwtKey": "",
    "Issuer": "Cis",
    "TokenHours": 10
  },
  "Session": {
    "LoginLogPath": ""
  },
  "Reports": {
    "TemplateRoot": "",
    "MaxRows": 100000
  },
  "Files": {
    "Folders": {}
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseTls": true,
    "From": "notifications@medix.com.my",
    "PickupDirectory": ""
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  }
}
