<Project Sdk="Microsoft.NET.Sdk">

  <!-- Adapters: SQL Server (Dapper repositories, sessions), Excel / PDF writers, e-mail, file shares, caches.
       Implements the ports of Cis.Application. The ASP.NET Core shared framework is referenced only for the Microsoft.Extensions
       abstractions it carries (options, configuration, caching, logging, health checks). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Cis.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Stay on 6.2.x: 6.5.0+ is AGPL-3.0 (and throws unless a license is loaded); 6.2.4 is the last MIT release, as used by GENESIS. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- Transitive via MailKit, SqlClient and PDFsharp; 10.0.0 has known vulnerabilities (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cis.Application\Cis.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cis.Api.Tests" />
  </ItemGroup>

</Project>
