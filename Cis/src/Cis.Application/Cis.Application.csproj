<Project Sdk="Microsoft.NET.Sdk">

  <!-- Use cases: services, ports (repository / infrastructure interfaces), request / response models, validators.
       No database, HTTP or file-format libraries here: those live in Cis.Infrastructure and Cis.Api. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Cis.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cis.Domain\Cis.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cis.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Member tracking report catalogue and filter list, generated from the VB6 form and procedure (Cis/sql/tools). -->
    <EmbeddedResource Include="Reports\MbmTracking.catalogue.json" LogicalName="MbmTracking.catalogue.json" />
    <EmbeddedResource Include="Reports\MbmTracking.params.json" LogicalName="MbmTracking.params.json" />
    <EmbeddedResource Include="Reports\MbmTrackingJupiter.catalogue.json" LogicalName="MbmTrackingJupiter.catalogue.json" />
    <EmbeddedResource Include="Reports\MbmTrackingSimple.catalogue.json" LogicalName="MbmTrackingSimple.catalogue.json" />
    <EmbeddedResource Include="Reports\MbmTrackingJupiterSimple.catalogue.json" LogicalName="MbmTrackingJupiterSimple.catalogue.json" />
    <EmbeddedResource Include="Reports\ClmTracking.catalogue.json" LogicalName="ClmTracking.catalogue.json" />
    <EmbeddedResource Include="Reports\ClmTrackingSimple.catalogue.json" LogicalName="ClmTrackingSimple.catalogue.json" />
    <EmbeddedResource Include="Reports\ClmTrackingJupiter.catalogue.json" LogicalName="ClmTrackingJupiter.catalogue.json" />
    <EmbeddedResource Include="Reports\ClmTrackingJupiterSimple.catalogue.json" LogicalName="ClmTrackingJupiterSimple.catalogue.json" />
    <EmbeddedResource Include="Reports\ClmTrackingSun.catalogue.json" LogicalName="ClmTrackingSun.catalogue.json" />
    <EmbeddedResource Include="Reports\ClmTracking.params.json" LogicalName="ClmTracking.params.json" />
    <EmbeddedResource Include="Reports\ClmTracking2.catalogue.json" LogicalName="ClmTracking2.catalogue.json" />
    <EmbeddedResource Include="Reports\ClmTracking2Jupiter.catalogue.json" LogicalName="ClmTracking2Jupiter.catalogue.json" />
    <EmbeddedResource Include="Reports\ClmTracking2.params.json" LogicalName="ClmTracking2.params.json" />
  </ItemGroup>

</Project>
