Attribute VB_Name = "RptCheckList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
    
    If DataEnvironment1.rsCheckList.state = 1 Then
       DataEnvironment1.rsCheckList.Requery
    End If
    
    strsql = IIf(InStr(1, ChkStr(frmCheckingItems.CheckCriteria), "AND") = 0, "", Mid(Trim(frmCheckingItems.CheckCriteria), InStr(1, ChkStr(frmCheckingItems.CheckCriteria), "AND") + 3, Len(Trim(frmCheckingItems.CheckCriteria))))
    DataEnvironment1.rsCheckList.Filter = strsql
    DataEnvironment1.rsCheckList.Sort = "CatCode"
End Sub




