Attribute VB_Name = "RptFeeList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
    
    If DataEnvironment1.rsFEEList.state = 1 Then
       DataEnvironment1.rsFEEList.Requery
    End If
    
    strsql = IIf(InStr(1, ChkStr(frmMaintenanceCal.FEECriteria), "AND") = 0, "", Mid(Trim(frmMaintenanceCal.FEECriteria), InStr(1, ChkStr(frmMaintenanceCal.FEECriteria), "AND") + 3, Len(Trim(frmMaintenanceCal.FEECriteria))))
    DataEnvironment1.rsFEEList.Filter = strsql
    DataEnvironment1.rsFEEList.Sort = "FeeCode"
End Sub




