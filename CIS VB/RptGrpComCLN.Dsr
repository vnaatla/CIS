Private Sub DataReport_Initialize()
    
    If DataEnvironment1.rsGrpComCLNList.state = 1 Then
       DataEnvironment1.rsGrpComCLNList.Requery
    End If
    
    strsql = IIf(InStr(1, ChkStr(frmMaintenanceEntity.GRPCOMCLNCriteria), "AND") = 0, "", Mid(Trim(frmMaintenanceEntity.GRPCOMCLNCriteria), InStr(1, ChkStr(frmMaintenanceEntity.GRPCOMCLNCriteria), "AND") + 3, Len(Trim(frmMaintenanceEntity.GRPCOMCLNCriteria))))
    DataEnvironment1.rsGrpComCLNList.Filter = strsql
    DataEnvironment1.rsGrpComCLNList.Sort = "GRPCOMCode"
End Sub



