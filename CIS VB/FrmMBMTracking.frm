Private Sub BordxMCOSum(Optional strAppend As String)
Dim rst2 As New ADODB.Recordset
Dim rst3 As New ADODB.Recordset
Dim Record As ListItem
Dim sql As String
Dim sql2 As String
Dim sql3 As String
Dim sql4 As String

    total = 0
    TotalIC = 0
    TotalIA = 0
    TotalF = 0
    TotalFS = 0
    TotalGC = 0
    TotalGA = 0
    TotalH = 0
    TotalHS = 0
    TotalICMCO = 0
    TotalIAMCO = 0
    TotalFMCO = 0
    TotalGCMCO = 0
    TotalGAMCO = 0
    TotalHMCO = 0
    TotalMCO = 0
    TotalMCO2 = 0
    TotalP = 0
    TotalS1 = 0
    
    PAYOR = ""
    Bordx = ""
        
    lstMBMInquiryList.ListItems.Clear
        
    sql = " SELECT PAYCode, MBMBordxDate From VIEW_CISMBM_Search Where 0 = 0 "
    
    sql2 = " GROUP BY PAYCode, MBMBordxDate ORDER BY PAYCode, MBMBordxDate "
    
    If Len(Trim(strAppend)) Then
        sql = sql + strAppend + sql2
    Else
        sql = sql + sql2
    End If
    
    rst2.Open sql, medixmasterconn, adOpenKeyset, adLockOptimistic
        
    Do
        Do Until rst2.EOF
                        
            With rst2
    
                If Len(rst2!PAYCode) Then
                    Set Record = lstMBMInquiryList.ListItems.Add(, , rst2!PAYCode)
                    PAYOR = Trim(rst2!PAYCode)
                ElseIf rst2!PAYCode = "" Then
                    Set Record = lstMBMInquiryList.ListItems.Add(, , "Empty")
                    PAYOR = ""
                Else
                    Set Record = lstMBMInquiryList.ListItems.Add(, , "Empty")
                    PAYOR = "NULL"
                End If
                
                If Len(rst2!MBMBordxDate) Then
                   Record.SubItems(1) = rst2!MBMBordxDate
                   Bordx = rst2!MBMBordxDate
                Else
                   Record.SubItems(1) = "Empty"
                   Bordx = "NULL"
                End If
                
                Call CountICBordxMCOSum(strAppend)
                
                If Len(TotalICMCO) Then
                   Record.SubItems(2) = Format(TotalICMCO, "#,##0.00")
                End If
                
                If Len(TotalIC) Then
                   Record.SubItems(9) = TotalIC
                End If
                
                Call CountIABordxMCOSum(strAppend)
                
                If Len(TotalIAMCO) Then
                   Record.SubItems(3) = Format(TotalIAMCO, "#,##0.00")
                End If
                
                If Len(TotalIA) Then
                   Record.SubItems(10) = TotalIA
                End If
                
                Call CountFBordxMCOSum(strAppend)
                
                If Len(TotalFMCO) Then
                   Record.SubItems(4) = Format(TotalFMCO, "#,##0.00")
                End If
                
                If Len(TotalF) Then
                   Record.SubItems(11) = TotalF
                End If
                
                Call CountGCBordxMCOSum(strAppend)
                
                If Len(TotalGCMCO) Then
                   Record.SubItems(5) = Format(TotalGCMCO, "#,##0.00")
                End If
                
                If Len(TotalGC) Then
                   Record.SubItems(12) = TotalGC
                End If
                
                Call CountGABordxMCOSum(strAppend)
                
                If Len(TotalGAMCO) Then
                   Record.SubItems(6) = Format(TotalGAMCO, "#,##0.00")
                End If
                
                If Len(TotalGA) Then
                   Record.SubItems(13) = TotalGA
                End If
                
                Call CountHBordxMCOSum(strAppend)
                
                If Len(TotalHMCO) Then
                   Record.SubItems(7) = Format(TotalHMCO, "#,##0.00")
                End If
                
                If Len(TotalH) Then
                   Record.SubItems(14) = TotalH
                End If
                
                Call CountFSBordxMCOSum(strAppend)
                
                If Len(TotalFS) Then
                   Record.SubItems(15) = TotalFS
                End If
                
                Call CountHSBordxMCOSum(strAppend)
                
                If Len(TotalHS) Then
                   Record.SubItems(16) = TotalHS
                End If
                
                TotalMCO = (CDbl(TotalICMCO) + CDbl(TotalIAMCO) + CDbl(TotalFMCO) + CDbl(TotalGCMCO) + CDbl(TotalGAMCO) + CDbl(TotalHMCO))
                Record.SubItems(8) = Format(TotalMCO, "#,##0.00")
                
                total = (CDbl(TotalIC) + CDbl(TotalIA) + CDbl(TotalF) + CDbl(TotalGC) + CDbl(TotalGA) + CDbl(TotalH) + CDbl(TotalFS) + CDbl(TotalHS))
                Record.SubItems(17) = total
                                
                TotalP = TotalP + (CDbl(TotalIC) + CDbl(TotalIA) + CDbl(TotalF) + CDbl(TotalGC) + CDbl(TotalGA) + CDbl(TotalH))
                lblTotalPrincipalCount = TotalP
                
                TotalS1 = TotalS1 + (CDbl(TotalFS) + CDbl(TotalHS))
                lbltotalSuppCount = TotalS1
                    
                TotalMCO2 = CDbl(TotalMCO2) + CDbl(TotalMCO)
                LblMCO = Format(TotalMCO2, "#,##0.00")
                
                lblTotalRecord = CDbl(TotalP) + CDbl(TotalS1)
                
                
            End With
            rst2.MoveNext
                
            DoEvents
        
            If intExit = 1 Then
                Check = False
                Exit Do
            End If
            Loop
        Loop Until Check = False
    intExit = 0
    
    If lstMBMInquiryList.ListItems.Count = 0 Then
        MsgBox "No record found!", vbOKOnly + vbCritical, DialogBoxTitle
        CmdClear.Enabled = True
        cmdExit.Enabled = True
        CmdPrintFile.Enabled = True
    End If
    
    rst2.Close
    Set rst2 = Nothing
    CmdClear.Enabled = True
    cmdExit.Enabled = True
    CmdPrintFile.Enabled = True
End Sub

