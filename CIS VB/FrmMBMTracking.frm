Private Sub InvoicePremiumSum(Optional strAppend As String)
Dim rst2 As New ADODB.Recordset
Dim rst3 As New ADODB.Recordset
Dim Record As ListItem
Dim sql As String
Dim sql2 As String
Dim sql3 As String
Dim sql4 As String

    total = 0
    TotalIC = 0
    TotalIA = 0
    TotalF = 0
    TotalFS = 0
    TotalGC = 0
    TotalGA = 0
    TotalH = 0
    TotalHS = 0
    TotalICPremium = 0
    TotalIAPremium = 0
    TotalFPremium = 0
    TotalGCPremium = 0
    TotalGAPremium = 0
    TotalHPremium = 0
    totalPrem = 0
    totalPrem2 = 0
    TotalP = 0
    TotalS1 = 0
    
    PAYOR = ""
    Invoice = ""
    InvDate = ""
        
    lstMBMInquiryList.ListItems.Clear
        
    sql = " SELECT PAYCode, MBMInvoiceNo, MBMInvoiceDate From VIEW_CISMBM_Search Where 0 = 0 "
    
    sql2 = " GROUP BY PAYCode, MBMInvoiceNo, MBMInvoiceDate ORDER BY PAYCode "
    
    If Len(Trim(strAppend)) Then
        sql = sql + strAppend + sql2
    Else
        sql = sql + sql2
    End If
    
    rst2.Open sql, medixmasterconn, adOpenKeyset, adLockOptimistic
        
    Do
        Do Until rst2.EOF
                        
            With rst2
    
                Set Record = lstMBMInquiryList.ListItems.Add(, , rst2!PAYCode)
                PAYOR = rst2!PAYCode
                                
                If Len(rst2!MBMInvoiceNo) Then
                   Record.SubItems(1) = Trim(rst2!MBMInvoiceNo)
                   Invoice = Trim(rst2!MBMInvoiceNo)
                ElseIf rst2!MBMInvoiceNo = "" Then
                    Record.SubItems(1) = "Empty"
                    Invoice = ""
                Else
                    Record.SubItems(1) = "Empty"
                    Invoice = "NULL"
                End If
                             
                If Len(rst2!MBMInvoiceDate) Then
                   Record.SubItems(2) = Format(rst2!MBMInvoiceDate, "dd/mm/yyyy")
                   InvDate = Trim(rst2!MBMInvoiceDate)
                ElseIf rst2!MBMInvoiceDate = Null Then
                    Record.SubItems(2) = "Empty"
                    InvDate = ""
                Else
                    Record.SubItems(2) = "Empty"
                    InvDate = "NULL"
                End If
                
                Call CountICPremiumSum(strAppend)
                
                If Len(TotalICPremium) Then
                   Record.SubItems(3) = Format(TotalICPremium, "#,##0.00")
                End If
                
                If Len(TotalIC) Then
                   Record.SubItems(10) = TotalIC
                End If
                
                Call CountIAPremiumSum(strAppend)
                
                If Len(TotalIAPremium) Then
                   Record.SubItems(4) = Format(TotalIAPremium, "#,##0.00")
                End If
                
                If Len(TotalIA) Then
                   Record.SubItems(11) = TotalIA
                End If
                
                Call CountFPremiumSum(strAppend)
                
                If Len(TotalFPremium) Then
                   Record.SubItems(5) = Format(TotalFPremium, "#,##0.00")
                End If
                
                If Len(TotalF) Then
                   Record.SubItems(12) = TotalF
                End If
                
                Call CountGCPremiumSum(strAppend)
                
                If Len(TotalGCPremium) Then
                   Record.SubItems(6) = Format(TotalGCPremium, "#,##0.00")
                End If
                
                If Len(TotalGC) Then
                   Record.SubItems(13) = TotalGC
                End If
                
                Call CountGAPremiumSum(strAppend)
                
                If Len(TotalGAPremium) Then
                   Record.SubItems(7) = Format(TotalGAPremium, "#,##0.00")
                End If
                
                If Len(TotalGA) Then
                   Record.SubItems(14) = TotalGA
                End If
                
                Call CountHPremiumSum(strAppend)
                
                If Len(TotalHPremium) Then
                   Record.SubItems(8) = Format(TotalHPremium, "#,##0.00")
                End If
                
                If Len(TotalH) Then
                   Record.SubItems(15) = TotalH
                End If
                
                Call CountFSPremiumSum(strAppend)
                
                If Len(TotalFS) Then
                   Record.SubItems(16) = TotalFS
                End If
                
                Call CountHSPremiumSum(strAppend)
                
                If Len(TotalHS) Then
                   Record.SubItems(17) = TotalHS
                End If
                
                totalPrem = (CDbl(TotalICPremium) + CDbl(TotalIAPremium) + CDbl(TotalFPremium) + CDbl(TotalGCPremium) + CDbl(TotalGAPremium) + CDbl(TotalHPremium))
                Record.SubItems(9) = Format(totalPrem, "#,##0.00")
                
                total = (CDbl(TotalIC) + CDbl(TotalIA) + CDbl(TotalF) + CDbl(TotalGC) + CDbl(TotalGA) + CDbl(TotalH) + CDbl(TotalFS) + CDbl(TotalHS))
                Record.SubItems(18) = total
                
                TotalP = TotalP + (CDbl(TotalIC) + CDbl(TotalIA) + CDbl(TotalF) + CDbl(TotalGC) + CDbl(TotalGA) + CDbl(TotalH))
                lblTotalPrincipalCount = TotalP
                
                TotalS1 = TotalS1 + (CDbl(TotalFS) + CDbl(TotalHS))
                lbltotalSuppCount = TotalS1
                    
                totalPrem2 = CDbl(totalPrem2) + CDbl(totalPrem)
                LblPrem = Format(totalPrem2, "#,##0.00")
                
                lblTotalRecord = CDbl(TotalP) + CDbl(TotalS1)
                
            End With
            rst2.MoveNext
            DoEvents
        
            If intExit = 1 Then
                Check = False
                Exit Do
            End If
            Loop
        Loop Until Check = False
    intExit = 0
    
    If lstMBMInquiryList.ListItems.Count = 0 Then
        MsgBox "No record found!", vbOKOnly + vbCritical, DialogBoxTitle
        CmdClear.Enabled = True
        cmdExit.Enabled = True
        CmdPrintFile.Enabled = True
    End If
    
    rst2.Close
    Set rst2 = Nothing
    CmdClear.Enabled = True
    cmdExit.Enabled = True
    CmdPrintFile.Enabled = True
End Sub

