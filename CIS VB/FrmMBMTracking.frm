    totalSuppCount = 0
    TotalMCO = 0
    totalPrem = 0
    TotalAccess = 0
    LblMCO = ""
    LblPrem = ""
    GrpCompany = ""
    
    Screen.MousePointer = vbHourglass
     
    strCriteria = ""
     
    
    If Len(Mid(cboHLTCode, 1, 1)) Then
          strCriteria = strCriteria & "AND HLTCode= '" & Mid(cboHLTCode, 1, 1) & "' "
      End If
      If ChkHltType.Value = 1 Then
          strCriteria = strCriteria & " AND (HLTCode IS NULL OR HLTCode = '')"
      End If
      
      If ChkPayor.Value = 1 Then
          strCriteria = strCriteria & " AND (PAYCode IS NULL OR PAYCode = '')"
      End If
      
      If Len(Trim(Mid(cboINSCode, 1, 1))) Then
          strCriteria = strCriteria & " AND  INSCode = '" & Trim(Mid(cboINSCode, 1, 1)) & "'"
      End If
      If ChkInsType.Value = 1 Then
          strCriteria = strCriteria & " AND (INSCode IS NULL OR INSCode = '')"
      End If
      
      If ChkMemType.Value = 1 Then
          strCriteria = strCriteria & " AND (MBMMemberType IS NULL OR MBMMemberType = '')"
      End If
      
      If Len(Trim(Mid(CboAdultChild, 1, 1))) Then
          strCriteria = strCriteria & " AND MBMAdultChild= '" & Trim(Mid(CboAdultChild, 1, 1)) & "' "
      End If
      
      If ChkAdultChild.Value = 1 Then
          strCriteria = strCriteria & " AND (MBMAdultChild IS NULL OR MBMAdultChild = '')"
      End If
           
      
      If Len(Trim(Mid(CboRace, 1, 1))) Then
          strCriteria = strCriteria & " AND RACCode = '" & Trim(Mid(CboRace, 1, 1)) & "' "
      End If
      If ChkRace.Value = 1 Then
         strCriteria = strCriteria + " AND (RACCode Is null OR RACCode = '')"
      End If
      
      If Len(Trim(Mid(CboSex, 1, 1))) Then
          strCriteria = strCriteria & " AND MBMSex = '" & Trim(Mid(CboSex, 1, 1)) & "'"
      End If
      If ChkSex.Value = 1 Then
          strCriteria = strCriteria + " AND (MBMSex Is null OR MBMSex = '')"
      End If
      
      If Len(Trim(Mid(CboRel, 1, 1))) Then
          strCriteria = strCriteria & " AND RELCode = '" & Trim(Mid(CboRel, 1, 1)) & "'"
      End If
      If ChkRel.Value = 1 Then
          strCriteria = strCriteria + " AND (RELCode Is null OR RELCode = '')"
      End If
      
      If Len(Trim(Mid(cboDataStatus, 1, 1))) Then
          strCriteria = strCriteria & " AND MBMDataStatus = '" & Trim(Mid(cboDataStatus, 1, InStr(1, cboDataStatus, "-") - 1)) & "' "
      End If
      If ChkDataStatus.Value = 1 Then
          strCriteria = strCriteria + " AND (MBMDataStatus Is null OR MBMDataStatus = '')"
      End If
      
      'If Len(Trim(Mid(CboStatus, 1, 1))) Then
          'strCriteria = strCriteria & " AND MBMStatus = '" & Trim(Mid(CboStatus, 1, 1)) & "'"
      'End If
      If Mid(CboStatus, 1, 1) = 0 Then
         strCriteria = strCriteria & " And MBMStatus = 'A'"
      ElseIf Mid(CboStatus, 1, 1) = 1 Then
         strCriteria = strCriteria & " And MBMStatus = 'C'"
      ElseIf Mid(CboStatus, 1, 1) = 2 Then
         strCriteria = strCriteria & " And MBMStatus = 'D'"
      ElseIf Mid(CboStatus, 1, 1) = 3 Then
        strCriteria = strCriteria & " And (MBMStatus = 'A' OR MBMStatus = 'C')"
      ElseIf Mid(CboStatus, 1, 1) = 4 Then
         strCriteria = strCriteria & " And MBMStatus = 'S'"
      End If
      If ChkStatus.Value = 1 Then
          strCriteria = strCriteria + " AND (MBMStatus Is null OR MBMStatus = '')"
      End If
      
      If Len(Trim(Mid(CboExpired, 1, 1))) Then
          strCriteria = strCriteria & "AND MBMExpiredStatus = '" & Trim(Mid(CboExpired, 1, 1)) & "' "
      End If
      If ChkExpired.Value = 1 Then
          strCriteria = strCriteria + " AND (MBMExpiredStatus Is null OR MBMExpiredStatus = '')"
      End If
      
