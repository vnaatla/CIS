Private Sub CountSuppRecords(Optional strAppend As String)
Dim rst3 As New ADODB.Recordset
Dim Record As ListItem
Dim sql As String
Dim sql2 As String
Dim sql3 As String
        
    
    TotalS = 0
        
    sql = " SELECT PAYCode, HLTCode, INSCode, PLNCode, COUNT(MBMNumber) AS TotalS " & _
           " From View_CISMBM_Supplementary Where 0 = 0 "
           
    sql2 = " GROUP BY PAYCode, HLTCode, INSCode, PLNCode ORDER BY PAYCode "
    
    sql3 = " AND PAYCode = '" & Trim(PAYOR) & "' AND HLTCode = '" & Trim(HltType) & "' AND INSCode = '" & Trim(INSType) & "' AND PLNCode = '" & Trim(PlanType) & "'"
           
    
    If Len(Trim(strAppend)) Then
        sql = sql + strAppend + sql3 + sql2
    Else
        sql = sql + sql3 + sql2
    End If
    
    rst3.Open sql, medixmasterconn, adOpenKeyset, adLockOptimistic
    
        TotalS = IIf(IsNumeric(rst3!TotalS) = True, rst3!TotalS, 0)
        
    rst3.Close
    Set rst3 = Nothing
End Sub

