    If Len(Trim(strAppend)) Then
        sql = sql + strAppend + sql2
    Else
        sql = sql + sql2
    End If
    
    rst2.Open sql, medixmasterconn, adOpenKeyset, adLockOptimistic
        
    Do
        Do Until rst2.EOF
                        
            With rst2
    
                If Len(rst2!PAYCode) Then
                    Set Record = lstMBMInquiryList.ListItems.Add(, , rst2!PAYCode)
                    PAYOR = Trim(rst2!PAYCode)
                ElseIf rst2!PAYCode = "" Then
                    Set Record = lstMBMInquiryList.ListItems.Add(, , "Empty")
                    PAYOR = ""
                Else
                    Set Record = lstMBMInquiryList.ListItems.Add(, , "Empty")
                    PAYOR = "NULL"
                End If
                
                If Len(rst2!MBMBordxDate) Then
                   Record.SubItems(1) = rst2!MBMBordxDate
                   Bordx = rst2!MBMBordxDate
                Else
                   Record.SubItems(1) = "Empty"
                   Bordx = "NULL"
                End If
                
                Call CountICBordxPremiumSum(strAppend)
                
                If Len(TotalICPremium) Then
                   Record.SubItems(2) = Format(TotalICPremium, "#,##0.00")
                End If
                
                If Len(TotalIC) Then
                   Record.SubItems(9) = TotalIC
                End If
                
                Call CountIABordxPremiumSum(strAppend)
                
                If Len(TotalIAPremium) Then
                   Record.SubItems(3) = Format(TotalIAPremium, "#,##0.00")
                End If
                
                If Len(TotalIA) Then
                   Record.SubItems(10) = TotalIA
                End If
                
                Call CountFBordxPremiumSum(strAppend)
                
                If Len(TotalFPremium) Then
                   Record.SubItems(4) = Format(TotalFPremium, "#,##0.00")
                End If
                
                If Len(TotalF) Then
                   Record.SubItems(11) = TotalF
                End If
                
                Call CountGCBordxPremiumSum(strAppend)
                
                If Len(TotalGCPremium) Then
                   Record.SubItems(5) = Format(TotalGCPremium, "#,##0.00")
                End If
                
                If Len(TotalGC) Then
                   Record.SubItems(12) = TotalGC
                End If
                
                Call CountGABordxPremiumSum(strAppend)
                
                If Len(TotalGAPremium) Then
                   Record.SubItems(6) = Format(TotalGAPremium, "#,##0.00")
                End If
                
                If Len(TotalGA) Then
                   Record.SubItems(13) = TotalGA
                End If
                
                Call CountHBordxPremiumSum(strAppend)
                
                If Len(TotalHPremium) Then
                   Record.SubItems(7) = Format(TotalHPremium, "#,##0.00")
                End If
                
                If Len(TotalH) Then
                   Record.SubItems(14) = TotalH
                End If
                
                Call CountFSBordxPremiumSum(strAppend)
                
                If Len(TotalFS) Then
                   Record.SubItems(15) = TotalFS
                End If
                
                Call CountHSBordxPremiumSum(strAppend)
                
                If Len(TotalHS) Then
                   Record.SubItems(16) = TotalHS
                End If
                
                totalPrem = (CDbl(TotalICPremium) + CDbl(TotalIAPremium) + CDbl(TotalFPremium) + CDbl(TotalGCPremium) + CDbl(TotalGAPremium) + CDbl(TotalHPremium))
                Record.SubItems(8) = Format(totalPrem, "#,##0.00")
                
                total = (CDbl(TotalIC) + CDbl(TotalIA) + CDbl(TotalF) + CDbl(TotalGC) + CDbl(TotalGA) + CDbl(TotalH) + CDbl(TotalFS) + CDbl(TotalHS))
                Record.SubItems(17) = total
                
                TotalP = TotalP + (CDbl(TotalIC) + CDbl(TotalIA) + CDbl(TotalF) + CDbl(TotalGC) + CDbl(TotalGA) + CDbl(TotalH))
                lblTotalPrincipalCount = TotalP
                
                TotalS1 = TotalS1 + (CDbl(TotalFS) + CDbl(TotalHS))
                lbltotalSuppCount = TotalS1
                    
                totalPrem2 = CDbl(totalPrem2) + CDbl(totalPrem)
                LblPrem = Format(totalPrem2, "#,##0.00")
                
                lblTotalRecord = CDbl(TotalP) + CDbl(TotalS1)
                
            End With
            rst2.MoveNext
            DoEvents
        
            If intExit = 1 Then
                Check = False
                Exit Do
            End If
            Loop
        Loop Until Check = False
    intExit = 0
    
    If lstMBMInquiryList.ListItems.Count = 0 Then
        MsgBox "No record found!", vbOKOnly + vbCritical, DialogBoxTitle
        CmdClear.Enabled = True
        cmdExit.Enabled = True
        CmdPrintFile.Enabled = True
    End If
    
    rst2.Close
    Set rst2 = Nothing
    CmdClear.Enabled = True
    cmdExit.Enabled = True
    CmdPrintFile.Enabled = True
End Sub

