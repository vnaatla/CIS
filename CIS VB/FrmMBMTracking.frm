    TotalFS = 0
    TotalGC = 0
    TotalGA = 0
    TotalH = 0
    TotalHS = 0
    TotalICPremium = 0
    TotalIAPremium = 0
    TotalFPremium = 0
    TotalGCPremium = 0
    TotalGAPremium = 0
    TotalHPremium = 0
    totalPrem = 0
    totalPrem2 = 0
