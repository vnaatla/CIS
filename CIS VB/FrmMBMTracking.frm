Private Sub INSMBMListing(Optional strAppend As String)
Dim rst2 As New ADODB.Recordset
Dim Record As ListItem
Dim sql As String
Dim sql2 As String

    total = 0
    TotalP = 0
    TotalS = 0
    TotalS1 = 0
    TotalMCO = 0
    totalPrem = 0
    TotalAccess = 0
    PAYOR = ""
    HltType = ""
    INSType = ""
    
    lstMBMInquiryList.ListItems.Clear
        
    sql = " SELECT PAYCode, HLTCode, INSCode, COUNT(MBMNumber) AS TotalP, " & _
          " SUM(MBMMCOFee) AS MCOGross, SUM(MBMAccessFee) AS EAFee, " & _
          " SUM(MBMPremium) AS PremiumGross From VIEW_CISMBM_Search Where 0 = 0 "
                    
    sql2 = " GROUP BY PAYCode, HLTCode, INSCode ORDER BY PAYCode "
    
        
    If Len(Trim(strAppend)) Then
        sql = sql + strAppend + sql2
    Else
        sql = sql + sql2
    End If
    
    rst2.Open sql, medixmasterconn, adOpenKeyset, adLockOptimistic
    
    Do
        Do Until rst2.EOF
                            
            With rst2
                Set Record = lstMBMInquiryList.ListItems.Add(, , rst2!PAYCode)
                PAYOR = rst2!PAYCode
                
                If Len(rst2!HLTCode) Then
                   Record.SubItems(1) = rst2!HLTCode
                   HltType = rst2!HLTCode
                End If
                                
                If Len(rst2!INSCode) Then
                   Record.SubItems(2) = rst2!INSCode
                   INSType = rst2!INSCode
                End If
                
                If Len(rst2!TotalP) Then
                   Record.SubItems(3) = rst2!TotalP
                End If
                
                If Len(rst2!MCOGross) Then
                   Record.SubItems(5) = Format(rst2!MCOGross, "#,##0.00")
                Else
                   Record.SubItems(5) = "0.00"
                End If
                
                If Len(rst2!PremiumGross) Then
                   Record.SubItems(6) = Format(rst2!PremiumGross, "#,##0.00")
                Else
                   Record.SubItems(6) = "0.00"
                End If
                
                If Len(rst2!EAFee) Then
                   Record.SubItems(7) = Format(rst2!EAFee, "#,##0.00")
                Else
                   Record.SubItems(7) = "0.00"
                End If
                
                If Mid(ChkStr(CboMbmType), 1, 1) = "S" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountSuppRecordsINS(strAppend)
                End If
                
                If Len(TotalS) Then
                   Record.SubItems(4) = TotalS
                End If
                
                TotalP = TotalP + rst2!TotalP
                lblTotalPrincipalCount = TotalP
                
                TotalS1 = TotalS1 + CDbl(TotalS)
                lbltotalSuppCount = TotalS1
                
                If Len(rst2!MCOGross) Then
                    TotalMCO = TotalMCO + rst2!MCOGross
                End If
                LblMCO = Format(TotalMCO, "#,##0.00")
                
                If Len(rst2!PremiumGross) Then
                    totalPrem = totalPrem + rst2!PremiumGross
                End If
                LblPrem = Format(totalPrem, "#,##0.00")
                
                If Len(rst2!EAFee) Then
                    TotalAccess = TotalAccess + rst2!EAFee
                End If
                LblAccess = Format(TotalAccess, "#,##0.00")
                
                total = CDbl(TotalP) + CDbl(TotalS1)
                lblTotalRecord = total
                
            End With
            rst2.MoveNext
            DoEvents
        
            If intExit = 1 Then
                Check = False
                Exit Do
            End If
            Loop
    Loop Until Check = False
    intExit = 0
    'End If
    
    If lstMBMInquiryList.ListItems.Count = 0 Then
        MsgBox "No record found!", vbOKOnly + vbCritical, DialogBoxTitle
        CmdClear.Enabled = True
        cmdExit.Enabled = True
        CmdPrintFile.Enabled = True
    End If
    
    rst2.Close
    Set rst2 = Nothing
    CmdClear.Enabled = True
    cmdExit.Enabled = True
    CmdPrintFile.Enabled = True
End Sub

