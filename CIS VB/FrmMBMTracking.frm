Private Sub GrpComSum(Optional strAppend As String)
Dim rst2 As New ADODB.Recordset
Dim rst3 As New ADODB.Recordset
Dim Record As ListItem
Dim sql As String
Dim sql2 As String
Dim sql3 As String
Dim sql4 As String

    total = 0
    TotalP = 0
    TotalS = 0
    TotalS1 = 0
    TotalMCO = 0
    GrpCom = ""
            
    lstMBMInquiryList.ListItems.Clear
        
    sql = " SELECT MBMGroupCompany, COUNT(MBMNumber) AS TotalP, " & _
          " SUM(MBMMCOFee) AS MCOGross From VIEW_CISMBM_Search Where 0 = 0 "
    
    sql2 = " GROUP BY MBMGroupCompany ORDER BY MBMGroupCompany "
    
    If Len(Trim(strAppend)) Then
        sql = sql + strAppend + sql2
    Else
        sql = sql + sql2
    End If
    
    rst2.Open sql, medixmasterconn, adOpenKeyset, adLockOptimistic
        
    Do
        Do Until rst2.EOF
                        
            With rst2
    
                If Len(rst2!MBMGroupCompany) Then
                    Set Record = lstMBMInquiryList.ListItems.Add(, , Trim(rst2!MBMGroupCompany))
                    GrpCom = Trim(rst2!MBMGroupCompany)
                ElseIf rst2!MBMGroupCompany = "" Then
                    Set Record = lstMBMInquiryList.ListItems.Add(, , "Empty")
                    GrpCom = ""
                Else
                    Set Record = lstMBMInquiryList.ListItems.Add(, , "Empty")
                    GrpCom = "NULL"
                End If
                
                If Len(rst2!TotalP) Then
                   Record.SubItems(1) = rst2!TotalP
                End If
                
                If Len(rst2!MCOGross) Then
                   Record.SubItems(4) = Format(rst2!MCOGross, "#,##0.00")
                Else
                   Record.SubItems(4) = "0.00"
                End If
                
                If Mid(ChkStr(CboMbmType), 1, 1) = "S" Or Mid(ChkStr(CboMbmType), 1, 1) = "B" Then
                    Call CountSuppRecordsGrpComSum(strAppend)
                End If
                
                If Len(TotalS) Then
                   Record.SubItems(2) = TotalS
                End If
                
                Record.SubItems(3) = CDbl(Record.SubItems(1)) + CDbl(TotalS)
                
                TotalP = TotalP + rst2!TotalP
                lblTotalPrincipalCount = TotalP
                
                TotalS1 = TotalS1 + CDbl(TotalS)
                lbltotalSuppCount = TotalS1
                
                If Len(rst2!MCOGross) Then
                    TotalMCO = TotalMCO + rst2!MCOGross
                End If
                LblMCO = Format(TotalMCO, "#,##0.00")
                
                total = CDbl(TotalP) + CDbl(TotalS1)
                lblTotalRecord = total
                
            End With
            rst2.MoveNext
            DoEvents
        
            If intExit = 1 Then
                Check = False
                Exit Do
            End If
            Loop
        Loop Until Check = False
    intExit = 0
    
    If lstMBMInquiryList.ListItems.Count = 0 Then
        MsgBox "No record found!", vbOKOnly + vbCritical, DialogBoxTitle
        CmdClear.Enabled = True
        cmdExit.Enabled = True
        CmdPrintFile.Enabled = True
    End If
    
    rst2.Close
    Set rst2 = Nothing
    CmdClear.Enabled = True
    cmdExit.Enabled = True
    CmdPrintFile.Enabled = True
End Sub

