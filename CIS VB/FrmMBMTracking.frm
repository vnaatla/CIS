                  End If
                 End If
                 MBM.MoveNext
                 DoEvents
                 
                 If intExit = 1 Then
                     Check = False
                     Exit Do
                 End If
               Loop
        Loop Until Check = False
        Do
               If InStr(1, CboMbmType, "-") = 0 Then
                    tempCoverID = ""
                    tempMBMNumber = ""
                    Do Until MBMSupplementary.EOF
                     goThru = True
                     
                    If Trim(tempMBMNumber) = Trim(MBMSupplementary!MBMNumber) And _
                        Trim(tempCoverID) = Trim(MBMSupplementary!MBMCCoverID) Then
                        goThru = False
                    End If
                     
                     
                     If goThru = True Then
                        tempCoverID = MBMSupplementary!MBMCCoverID
                        tempMBMNumber = MBMSupplementary!MBMNumber
                        If Len(MBMSupplementary!MBMNumber) Then
                            Set MEMList = lstMBMInquiryList.ListItems.Add(, , MBMSupplementary!MBMNumber)
                        Else
                            Set MEMList = lstMBMInquiryList.ListItems.Add(, , "Empty")
                        End If
                        
                        With MEMList
                            If MBMSupplementary!MBMStatus = "S" Then
                                strName = Trim(MBMSupplementary!MBMName) & " (Suspended)"
                            ElseIf MBMSupplementary!MBMStatus = "C" Then
                                strName = Trim(MBMSupplementary!MBMName) & " (Cancelled)"
                            ElseIf MBMSupplementary!MBMStatus = "D" Then
                                strName = Trim(MBMSupplementary!MBMName) & " (Deleted)"
                            Else
                               strName = Trim(MBMSupplementary!MBMName)
                            End If
                            
                            .SubItems(1) = strName
                            
                            If Trim(MBMSupplementary!MBMPolicyNo) <> "" Then
                                .SubItems(2) = Trim(MBMSupplementary!MBMPolicyNo)
                            End If
                            
                            If Len(MBMSupplementary!MBMInvoiceNo) Then
                              .SubItems(3) = Trim(MBMSupplementary!MBMInvoiceNo)
                            End If
                            
                            If Len(MBMSupplementary!MBMInvoiceDate) Then
                              .SubItems(4) = Format(MBMSupplementary!MBMInvoiceDate, "dd/mm/yyyy")
                            End If
                            
                            If Len(MBMSupplementary!MBMBordxDate) Then
                              .SubItems(5) = Format(MBMSupplementary!MBMBordxDate, "dd/mm/yyyy")
                            End If
                            
                            If Len(Trim(MBMSupplementary!MBMBatchNo)) Then
                                .SubItems(6) = Trim(MBMSupplementary!MBMBatchNo)
                            End If
                            
                            If Len(Trim(MBMSupplementary!MBMValueDate)) Then
                                .SubItems(7) = Format(MBMSupplementary!MBMValueDate, "dd/mm/yyyy")
                            End If
                                                                                    
                            'If Len(MBMSupplementary!MBMMCOFee) Then
                              '.SubItems(8) = Format(MBMSupplementary!MBMMCOFee, "#,##0.00")
                            .SubItems(8) = "0.00"
                            'End If
                            
                        End With
                        totalSuppCount = totalSuppCount + 1
                        lbltotalSuppCount = totalSuppCount
                        lblCurrent = CDbl(TotalPrincipalCount) + CDbl(totalSuppCount)
                           
                     End If
                     MBMSupplementary.MoveNext
                    
                     DoEvents
                     
                     If intExit = 1 Then
                        Check = False
                        Exit Do
                     End If
                    Loop
                End If
         Loop Until Check = False
         intExit = 0
        MBM.Close
        Set MBM = Nothing
        CmdClear.Enabled = True
        If Len(Trim(CboMbmType)) = 0 Then
            MBMSupplementary.Close
            Set MBMSupplementary = Nothing
        End If
    End If
    
    Screen.MousePointer = vbDefault
    cmdExit.Enabled = True
    CmdClear.Enabled = True
    CmdPrintFile.Enabled = True
    If Msg And msg1 = 1 Then
        MsgBox "Sorry, No Record Found", vbOKOnly + vbCritical, DialogBoxTitle
        cmdExit.Enabled = True
        CmdClear.Enabled = True
        CmdPrintFile.Enabled = True
    End If
    
    End If
