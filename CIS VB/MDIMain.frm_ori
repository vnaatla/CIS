Private Sub MDIForm_Load()
    Dim hSysMenu As Long

    hSysMenu = GetSystemMenu(hwnd, False)
    RemoveMenu hSysMenu, SC_CLOSE, MF_BYCOMMAND
    Me.Caption = Version
    Me.Width = Screen.Width
    Me.Height = Screen.Height
    Me.Caption = DialogBoxTitle & " - " & "Main Menu"

End Sub


