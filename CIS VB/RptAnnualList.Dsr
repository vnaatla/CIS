Attribute VB_Name = "RptAnnualList"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
    
    If DataEnvironment1.rsVisitList.state = 1 Then
       DataEnvironment1.rsVisitList.Requery
    End If
    
    strsql = IIf(InStr(1, ChkStr(frmMaintenancePlan.VisitCriteria), "AND") = 0, "", Mid(Trim(frmMaintenancePlan.VisitCriteria), InStr(1, ChkStr(frmMaintenancePlan.VisitCriteria), "AND") + 3, Len(Trim(frmMaintenancePlan.VisitCriteria))))
    DataEnvironment1.rsVisitList.Filter = strsql
    DataEnvironment1.rsVisitList.Sort = "VisitIndex"
End Sub


