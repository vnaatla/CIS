Attribute VB_Name = "RptDentalBNFEntry"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Private Sub DataReport_Initialize()
    
    If DataEnvironment1.rsDentalBNFEntry.state = 1 Then
       DataEnvironment1.rsDentalBNFEntry.Requery
    End If
    
    strsql = IIf(InStr(1, ChkStr(frmMaintenanceBNFDental.TBNFCriteria), "AND") = 0, "", Mid(Trim(frmMaintenanceBNFDental.TBNFCriteria), InStr(1, ChkStr(frmMaintenanceBNFDental.TBNFCriteria), "AND") + 3, Len(Trim(frmMaintenanceBNFDental.TBNFCriteria))))
    DataEnvironment1.rsDentalBNFEntry.Filter = strsql
    DataEnvironment1.rsDentalBNFEntry.Sort = "BNFCode"
End Sub


